  M -->|"Verify missing and multiple scores"| Q["Apply excludeDecayed explicitly<br/>Keep the consumer's baseline filters"]
  Q -->|"Complete all export pages"| D["Reconcile managed detections<br/>Withdraw entries that stop matching"]
  class S,M,Q accent;
  class D success;
